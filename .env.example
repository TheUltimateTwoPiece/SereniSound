# Public values: safe for browser use, but restrict the Google key by referrer/API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_BROWSER_RESTRICTED_GOOGLE_MAPS_KEY

# Server only. Never expose this to the browser or ESP32.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
DEVICE_UPDATE_TOKEN=CREATE_A_LONG_RANDOM_DEVICE_TOKEN

# Brevo SMTP for caregiver warning emails (server only).
# BREVO_SMTP_USER is only an authentication username: the email you sign in to
# brevo.com with. The key is the SMTP key from Brevo > SMTP & API > SMTP.
BREVO_SMTP_USER=YOUR_BREVO_ACCOUNT_LOGIN_EMAIL
BREVO_SMTP_KEY=YOUR_BREVO_SMTP_KEY
# Who the warnings are sent from, and where replies go. Brevo only accepts a
# sender it has verified, so use your Brevo account address if the school address
# cannot be verified. Defaults to BREVO_SMTP_USER when empty.
ALERT_FROM_EMAIL=YOUR_VERIFIED_SENDER_EMAIL
# Optional overrides; these defaults are correct for Brevo.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587

# Optional: a Brevo API key (Brevo > SMTP & API > API Keys). When this is set it
# is used instead of SMTP, so BREVO_SMTP_USER and BREVO_SMTP_KEY are not needed.
# BREVO_API_KEY=xkeysib-YOUR_API_KEY
